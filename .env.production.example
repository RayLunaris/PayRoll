# PayrollPro - Production Environment Variables
# Copy this file to .env.production and fill in real values.
#
# Usage:
#   cp .env.production.example .env.production
#   openssl rand -base64 48   # generate strong secret
#   docker-compose -f docker/production/docker-compose.prod.yml --env-file .env.production up -d

# Domain (tanpa https://, dipakai oleh Nginx & CORS)
DOMAIN=payroll.example.com

# Database password (harus kuat, jangan pakai 'postgres')
DB_PASSWORD=change-me-strong-db-password

# Redis password (harus kuat)
REDIS_PASSWORD=change-me-strong-redis-password

# JWT secrets (generate: openssl rand -base64 48)
JWT_SECRET=change-me-generate-with-openssl
JWT_REFRESH_SECRET=change-me-generate-with-openssl
JWT_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=7d
