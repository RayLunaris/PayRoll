# PayrollPro - Production Environment Variables
# Copy this file to .env.production and fill in real values.
#
# Usage:
#   cp .env.production.example .env.production
#   openssl rand -base64 48   # generate strong secret
#   docker-compose -f docker/production/docker-compose.prod.yml --env-file .env.production up -d

# Domain (tanpa https://, dipakai oleh Nginx & CORS)
DOMAIN=payroll.example.com

# Database password (harus kuat, jangan pakai 'postgres')
DB_PASSWORD=change-me-strong-db-password

# Redis password (harus kuat)
REDIS_PASSWORD=change-me-strong-redis-password

# JWT secrets (generate: openssl rand -base64 48)
JWT_SECRET=change-me-generate-with-openssl
# auth-service only — MUST be different from JWT_SECRET
JWT_REFRESH_SECRET=change-me-generate-with-openssl
JWT_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=7d

# Gateway CORS — comma-separated browser origins allowed to call the API.
# Include your Vercel production URL; optional preview wildcard.
# e.g. CORS_ORIGIN=https://your-app.vercel.app,https://*.vercel.app
CORS_ORIGIN=https://your-app.vercel.app

# Frontend (Vercel project env — required at build time, include /api suffix)
NEXT_PUBLIC_API_URL=https://api.example.com/api
NEXT_PUBLIC_WS_URL=wss://api.example.com
NEXT_PUBLIC_APP_URL=https://your-app.vercel.app
