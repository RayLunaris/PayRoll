{
  "name": "payrollpro",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "node scripts/dev-light.mjs",
    "dev:light": "node scripts/dev-light.mjs",
    "dev:core": "node scripts/dev-light.mjs core",
    "dev:payroll-full": "node scripts/dev-light.mjs payroll",
    "dev:attendance-full": "node scripts/dev-light.mjs attendance",
    "dev:leave-full": "node scripts/dev-light.mjs leave",
    "dev:social-full": "node scripts/dev-light.mjs social",
    "dev:backend": "node scripts/dev-light.mjs backend",
    "dev:web": "pnpm --filter @payrollpro/web dev",
    "dev:gateway": "pnpm --filter @payrollpro/api-gateway dev",
    "dev:auth": "pnpm --filter @payrollpro/auth-service dev",
    "dev:employee": "pnpm --filter @payrollpro/employee-service dev",
    "dev:payroll": "pnpm --filter @payrollpro/payroll-service dev",
    "dev:attendance": "pnpm --filter @payrollpro/attendance-service dev",
    "dev:leave": "pnpm --filter @payrollpro/leave-service dev",
    "dev:social": "pnpm --filter @payrollpro/social-service dev",
    "dev:shift": "pnpm --filter @payrollpro/shift-service dev",
    "dev:ws": "pnpm --filter @payrollpro/websocket dev",
    "services:up": "docker start payrollpro-postgres payrollpro-redis 2>/dev/null || docker compose up -d postgres redis",
    "dev:all": "node scripts/dev-light.mjs all",
    "build": "pnpm -r build",
    "db:generate": "pnpm --filter @payrollpro/db generate",
    "db:migrate": "pnpm --filter @payrollpro/db migrate",
    "db:seed": "pnpm --filter @payrollpro/db seed",
    "db:studio": "pnpm --filter @payrollpro/db studio",
    "docker:up": "docker-compose up -d",
    "docker:down": "docker-compose down",
    "docker:logs": "docker-compose logs -f",
    "docker:clean-unused": "docker stop payroll-payroll-service payroll-tax-service payroll-attendance-service payroll-leave-service payroll-employee-service payroll-auth-service 2>/dev/null || true",
    "test:unit": "pnpm -r --if-present test",
    "test:e2e": "pnpm --filter @payrollpro/web test:e2e"
  },
  "engines": {
    "node": ">=22"
  }
}
